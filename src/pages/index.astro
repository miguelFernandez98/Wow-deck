    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        import { ScrollToPlugin } from "gsap/ScrollToPlugin";
        gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

        // FAQ overlay
        const faqLinks = document.querySelectorAll("#faq");
        const overlay = document.querySelector("[data-faq-overlay]");
        const closeButton = document.querySelector("[data-close-faq]");
        if (faqLinks.length && overlay && closeButton) {
            faqLinks.forEach((faq) => {
                faq.addEventListener("click", (e) => {
                    e.preventDefault();
                    gsap.to(overlay, {
                        duration: 0.4,
                        display: "flex",
                        opacity: 1,
                    });
                    gsap.set(closeButton, { display: "block" });
                    gsap.to(document.body, { overflow: "hidden" });
                });
            });
            closeButton.addEventListener("click", () => {
                gsap.to(overlay, {
                    duration: 0.3,
                    display: "none",
                    opacity: 0,
                });
                gsap.set(closeButton, { display: "none" });
                gsap.to(document.body, { overflow: "auto" });
            });
        }

        // Sidebar
        const sidebar = document.querySelector("[data-sidebar]");
        const openBtn = document.querySelector("[data-open-sidebar]");
        const closeBtns = document.querySelectorAll("[data-close-sidebar]");
        if (sidebar && openBtn) {
            const openSidebar = () => {
                sidebar.style.display = "flex";
                requestAnimationFrame(
                    () => (sidebar.style.transform = "translateX(0)"),
                );
            };
            const closeSidebar = () => {
                sidebar.style.transform = "translateX(100%)";
                setTimeout(() => (sidebar.style.display = "none"), 300);
            };
            openBtn.addEventListener("click", openSidebar);
            closeBtns.forEach((btn) =>
                btn.addEventListener("click", closeSidebar),
            );
        }

        // Google reviews link
        const sectionGoogle = document.querySelector(".section-google");
        sectionGoogle?.addEventListener("click", function () {
            window.open(
                "https://www.google.com/search?sca_esv=eba07bfb50991dad&q=Wow-Deck&stick=H4sIAAAAAAAAAONgU1I1qDBLNLAwMEozNbUwtjBNTLO0MqiwsExKTTVJTUsxSUwxSDNNWsTKEZ5fruuSmpwNACxn3Y00AAAA&mat=CfyWlTClQ8NH&ved=2ahUKEwi_0KyRkIuLAxULQkEAHavjNf4QrMcEegQIKBAC",
                "_blank",
            );
        });

        // FAQ accordion (questions)
        const questions = document.querySelectorAll(".question");
        questions.forEach((question) => {
            question.addEventListener("click", () => {
                const active = document.querySelector(".question.active");
                if (active && active !== question) {
                    active.classList.toggle("active");
                    active.nextElementSibling.style.maxHeight = 0;
                    active.nextElementSibling.classList.remove("expanded");
                }
                question.classList.toggle("active");
                const answer = question.nextElementSibling;
                if (question.classList.contains("active")) {
                    answer.style.maxHeight = answer.scrollHeight + "px";
                    answer.classList.add("expanded");
                } else {
                    answer.style.maxHeight = 0;
                    answer.classList.remove("expanded");
                }
            });
        });

        // Accordion (Bootstrap-style collapse)
        document.querySelectorAll(".accordion-button").forEach((button) => {
            button.addEventListener("click", () => {
                const targetId = button.getAttribute("data-bs-target");
                const target = document.querySelector(targetId);
                const isCollapsed = button.classList.contains("collapsed");
                button.classList.toggle("collapsed", !isCollapsed);
                button.setAttribute("aria-expanded", String(isCollapsed));
                target.classList.toggle("show", isCollapsed);
            });
        });

        // Cookie banner
        const cookieBanner = document.querySelector("[data-cookie-banner]");
        const acceptCookies = document.getElementById("accept-cookies");
        const rejectCookies = document.getElementById("reject-cookies");

        const hideCookieBanner = () => {
            cookieBanner.classList.remove("show");
            try {
                sessionStorage.setItem("wowdeck-cookies", "dismissed");
            } catch {}
        };

        const shouldShow = () => {
            try {
                return !localStorage.getItem("wowdeck-cookies-accepted");
            } catch {
                return true;
            }
        };

        if (cookieBanner) {
            if (shouldShow()) {
                requestAnimationFrame(() => cookieBanner.classList.add("show"));
            }
            acceptCookies?.addEventListener("click", () => {
                try {
                    localStorage.setItem("wowdeck-cookies-accepted", "true");
                } catch {}
                hideCookieBanner();
            });
            rejectCookies?.addEventListener("click", hideCookieBanner);
        }

        // Scroll-triggered reveal animations (replaces Webflow data-w-id interactions)
        if (
            window.matchMedia("(prefers-reduced-motion: no-preference)").matches
        ) {
            // Hero entrance: jaguar slides in from the left, text stacks up
            gsap.from(".hero-left-column", {
                opacity: 0,
                x: -80,
                duration: 1,
                ease: "power2.out",
            });
            gsap.from(".hero-right-column > *", {
                opacity: 0,
                y: 40,
                stagger: 0.15,
                duration: 0.9,
                ease: "power2.out",
                delay: 0.3,
            });

            // Generic fade-up on section content as it scrolls into view
            gsap.utils
                .toArray([
                    ".container .heading-4",
                    ".container > .paragraph-2",
                    ".h2-3",
                    ".div-block-15",
                    ".spec-item-1",
                    ".spec-item-2",
                    ".back-text-block",
                    ".googleReviews",
                    "#AboutUS",
                    ".grigMesageImg",
                    ".grid-container > div",
                    ".grid-container1 .divContacUs",
                ])
                .forEach((el) => {
                    gsap.from(el, {
                        opacity: 0,
                        y: 50,
                        duration: 0.8,
                        ease: "power2.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: el,
                            start: "top 88%",
                            once: true,
                        },
                    });
                });

            // Car images (front/back view + tyres): smooth fade/pan reveal.
            // immediateRender:false => never gets stuck hidden if the trigger misses.
            gsap.utils
                .toArray([".front-view-2", ".back-view", ".car-drawing"])
                .forEach((el) => {
                    gsap.from(el, {
                        opacity: 0,
                        y: 60,
                        duration: 1,
                        ease: "power2.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: el,
                            start: "top 95%",
                            once: true,
                        },
                    });
                });

            // --- Webflow IX2 ports: continuous scroll (parallax) animations ---
            // Solo en escritorio grande: los desplazamientos horizontales fijos
            // desbordan la imagen y el titulo en tablets/moviles.
            if (window.innerWidth <= 1200) {
                gsap.set([".front-view-2", ".back-view"], { x: 0 });
            }
            // a-6: front car glides -500px -> +1000px while its section crosses the viewport
            const frontView = document.querySelector(".front-view-2");
            const frontSection = frontView?.closest("section");
            if (frontView && frontSection && window.innerWidth > 1200) {
                gsap.fromTo(
                    frontView,
                    { x: -500 },
                    {
                        x: 1000,
                        ease: "none",
                        scrollTrigger: {
                            trigger: frontSection,
                            start: "top bottom",
                            end: "bottom top",
                            scrub: 0.6,
                        },
                    }
                );
            }

            // a-5: back car glides +500px -> -960px in the opposite direction
            const backView = document.querySelector(".back-view");
            const backSection = backView?.closest("section");
            if (backView && backSection && window.innerWidth > 1200) {
                gsap.fromTo(
                    backView,
                    { x: 500 },
                    {
                        x: -960,
                        ease: "none",
                        scrollTrigger: {
                            trigger: backSection,
                            start: "top bottom",
                            end: "bottom top",
                            scrub: 0.6,
                        },
                    }
                );
            }

            // a-3: hero parallax — jaguar flies up, graphics drop down, hero fades out
            const heroBlock = document.querySelector(".hero-container");
            if (heroBlock) {
                const heroParallax = [
                    { target: ".top-view-jaguar", y: -1200 },
                    { target: ".graphic-element-01", y: 800 },
                    { target: ".graphic-element-03", y: 2000 },
                    { target: ".graphic-element-02", y: 3000 },
                    { target: ".graphic-element-04", y: 3000 },
                ];
                heroParallax.forEach(({ target, y }) => {
                    const el = heroBlock.querySelector(target);
                    if (!el) return;
                    gsap.fromTo(el, { y: 0 }, {
                        y,
                        ease: "none",
                        scrollTrigger: {
                            trigger: heroBlock,
                            start: "top top",
                            end: "bottom top",
                            scrub: 0.6,
                        },
                    });
                });
                gsap.fromTo(
                    heroBlock,
                    { opacity: 1 },
                    {
                        opacity: 0,
                        ease: "none",
                        scrollTrigger: {
                            trigger: heroBlock,
                            start: "top top",
                            end: "bottom top",
                            scrub: 0.6,
                        },
                    }
                );
            }
        }
    </script>
</BaseLayout>
