---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy & Cookie Policy | Wow Deck";
const description = "Privacy and Cookie Policy for Wow Deck Ltd.";
---

<BaseLayout title={title} description={description}>
  <div class="legal-page">
    <img
      class="buttonBack"
      onclick="window.history.back()"
      src="/images/arrow_back.svg"
      alt="Back"
    />
    <section id="privacy-policy">
      <div class="card">
        <h1 class="primary-heading">Privacy &amp; Cookie Policy</h1>
        <p class="paragraph">
          <strong class="bold">PRIVACY STATEMENT</strong>
          <br />
          <br />
          <span class="bold">Introduction</span> <br />Welcome to Wow Deck Ltd.
          This Privacy Statement explains how Wow Deck Ltd. collects, uses, and
          discloses your information when you visit our website.
          <br />
          <br />
          <span class="bold">Information We Collect </span> <br />Wow Deck Ltd.
          may collect personal information that you provide directly, such as
          your name, email address, and other contact details when you:
          <br />
          <br />
          • Sign up for newsletters
          <br />
          • Contact us via forms or email
          <br />
          • Request information or services
          <br /><br />
          <span class="bold">How We Use Your Information </span> <br />Wow Deck
          Ltd. uses your information to:
          <br />
          <br />
          • Respond to inquiries and provide customer support
          <br />
          • Improve services and website functionality
          <br />
          • Send updates, marketing communications, and other relevant
          information
          <br /><br />
          <span class="bold">Cookies and Tracking Technologies </span> <br />The
          website uses cookies to enhance your browsing experience. Cookies are
          small data files stored on your device. Wow Deck Ltd. uses the
          following types of cookies:
          <br />
          <br />
          • <span class="bold">Necessary Cookies:</span> Essential for website
          functionality.
          <br />
          • <span class="bold">Performance Cookies</span> Collect information on
          website usage to improve user experience.
          <br />
          • <span class="bold">Functionality Cookies:</span> Remember your
          preferences and settings. <br />
          • <span class="bold">Targeting Cookies: </span> Deliver relevant
          advertisements and track the effectiveness of marketing campaigns.
          <br />
          <br />
          You can manage your cookie preferences through your browser settings.
          For more details on cookies, and how to control them, please review
          your Cookie Preferences.
          <br />
          <br />
          <span class="bold">Sharing Your Information </span> <br />Wow Deck
          Ltd. does not sell your personal information. We may share your
          information with third-party service providers who assist in operating
          our website and delivering our services, subject to confidentiality
          agreements.
          <br />
          <br />
          <span class="bold">Data Security </span> <br />Wow Deck Ltd.
          implements security measures to protect your personal information from
          unauthorised access and disclosure.
          <br />
          <br />
          <span class="bold">Your Rights </span> <br />You have the right to:
          <br />
          <br />
          • Opt-out of receiving marketing communications
          <br />
          • Access, update, or delete your personal information
          <br />
          • Withdraw consent at any time when Wow Deck Ltd. is relying on
          consent to process your information
          <br />
          <br />
          <span class="bold">Contact Us </span> <br />If you have any questions
          about this Privacy Statement or our data practices, please get in
          touch with us at getintouch@wow-deck.com.
          <br />
          <br />
          <span class="bold">Changes to This Privacy Statement </span> <br />Wow
          Deck Ltd. may update this Privacy Statement periodically. Changes will
          be posted on this page, and we encourage you to review it regularly.
          <br />
          <br />
          <span class="bold">Effective Date </span> <br />This Privacy Statement
          is effective as of 12 June 2024.
          <br />
          <br />
          <span class="bold">Agreement</span> <br />By visiting our website, you
          agree to the processing of your information as described in this
          Privacy Statement.
        </p>
      </div>
    </section>
    <footer>
      <p class="footer-heading">©2024 by Wow Deck Ltd. All rights reserved</p>
    </footer>
  </div>
</BaseLayout>
